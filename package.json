{
  "name": "dfks-portal",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "check": "npm run lint && npx tsc --noEmit",
    "test": "node --test tests/*.test.mjs && NODE_OPTIONS=--conditions=react-server tsx --test tests/*.test.ts && tsx --test tests/*.test.tsx",
    "i18n:audit": "node scripts/check-i18n-coverage.mjs",
    "agent:rules": "node scripts/check-agent-rules.mjs",
    "agent:rules:strict": "node scripts/check-agent-rules.mjs --strict",
    "audit:coverage": "node scripts/check-audit-coverage.mjs",
    "audit:coverage:strict": "node scripts/check-audit-coverage.mjs --strict",
    "audit:coverage:write": "node scripts/check-audit-coverage.mjs --write",
    "test:manual-work": "tsx --test tests/manual-work-flow.test.ts",
    "test:list-performance": "NODE_OPTIONS=--conditions=react-server tsx --test tests/list-load-performance.test.ts",
    "test:audit-lifecycle": "node --test tests/agent-rules.test.mjs tests/audit-lifecycle.test.mjs && NODE_OPTIONS=--conditions=react-server tsx --test tests/audit-log.test.ts tests/audit-sar.test.ts",
    "test:performance-smoke": "playwright test --config=playwright.performance.config.ts",
    "one-off:import-contract-archive": "NODE_OPTIONS=--conditions=react-server tsx scripts/one-off/import-dfks-contract-archive.ts",
    "one-off:replace-dlp-ocr": "NODE_OPTIONS=--conditions=react-server tsx scripts/one-off/replace-dlp-ocr-with-direct-vision.ts",
    "audit:vision-v3-geometry-backfill": "node scripts/audit-ocr-backfill.mjs audit-geometry-backfill",
    "one-off:vision-v3-geometry-backfill": "NODE_OPTIONS=--conditions=react-server tsx scripts/one-off/vision-v3-geometry-backfill.ts",
    "test:vision-v3-geometry-backfill": "NODE_OPTIONS=--conditions=react-server tsx --test tests/vision-v3-geometry-backfill-compliance.test.ts tests/contract-document-lease-cleanup-routes.test.ts tests/contract-ai-generation-fence.test.ts && node --test tests/ocr-backfill-audit.test.mjs tests/contract-document-geometry-backfill-concurrency.test.mjs cloud-run/contract-document-worker/*.test.mjs",
    "seed:broadcaster-logos": "tsx scripts/seed-broadcaster-logos.ts",
    "lint": "eslint",
    "db:link": "set -a && . ./.env.local && set +a && supabase link --project-ref icxywdymyaxluaxxcpye",
    "db:push": "set -a && . ./.env.local && set +a && supabase db push",
    "db:pull": "set -a && . ./.env.local && set +a && supabase db pull",
    "db:diff": "set -a && . ./.env.local && set +a && supabase db diff",
    "db:configure-contract-import-cron": "tsx scripts/configure-contract-import-cron.ts",
    "backfill:contract-evidence": "NODE_OPTIONS=--conditions=react-server tsx scripts/backfill-contract-field-evidence.ts",
    "recover:word-contracts": "node scripts/one-off/recover-word-contract-jobs.mjs",
    "test:recover-word-contracts": "node --test scripts/one-off/recover-word-contract-jobs.test.mjs",
    "one-off:clear-blocked-billing-ai-jobs": "node scripts/one-off/clear-blocked-billing-ai-jobs.mjs"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.108.1",
    "@types/papaparse": "^5.5.2",
    "@vercel/analytics": "2.0.1",
    "@vercel/speed-insights": "2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "docx": "^9.7.1",
    "exceljs": "4.4.0",
    "google-auth-library": "10.9.0",
    "jsonrepair": "^3.15.0",
    "lucide-react": "^0.563.0",
    "mammoth": "^1.12.0",
    "ml-matrix": "6.14.0",
    "next": "16.3.1",
    "next-themes": "^0.4.6",
    "papaparse": "^5.6.0",
    "pdf-lib": "1.17.1",
    "pdf-parse": "^1.1.4",
    "radix-ui": "^1.4.3",
    "react": "19.2.3",
    "react-day-picker": "^9.13.2",
    "react-dom": "19.2.3",
    "react-pdf": "^10.3.0",
    "recharts": "^3.7.0",
    "server-only": "0.0.1",
    "simple-statistics": "7.9.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.0",
    "word-extractor": "1.0.4",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "pg": "^8.22.0",
    "shadcn": "3.8.3",
    "supabase": "^2.109.1",
    "tailwindcss": "^4",
    "tsx": "^4.22.4",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5"
  },
  "overrides": {
    "@hono/node-server": "2.0.10",
    "brace-expansion": "1.1.18",
    "fast-uri": "3.1.7",
    "hono": "4.12.34",
    "ip-address": "10.3.1",
    "js-yaml": "4.3.1",
    "docx": {
      "nanoid": "5.1.16"
    },
    "nanoid": "3.3.18",
    "postcss": "8.5.23",
    "sharp": "0.35.0",
    "uuid": "11.1.1"
  }
}
